{
  "name": "helvetikon",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "node build/index.js",
    "start:migrate:prod": "prisma migrate deploy && yarn start:prod",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:db:up": "./scripts/test-db.sh up",
    "test:db:wait": "./scripts/test-db.sh wait",
    "test:db:down": "./scripts/test-db.sh down",
    "test:db:reset": "./scripts/test-db.sh reset",
    "test:db:seed": "./scripts/test-db.sh seed",
    "test:db:setup": "./scripts/test-db.sh setup",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install",
    "test": "yarn test:unit && yarn test:e2e",
    "generate": "prisma generate && node prisma/fix-prisma-module-specifier.js",
    "postinstall": "yarn generate"
  },
  "devDependencies": {
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.3",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^5.2.11",
    "@sveltejs/kit": "^2.17.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cookie": "^0.4.1",
    "@types/dom-mediacapture-record": "1.0.22",
    "@types/ffmpeg": "1.0.7",
    "@types/jsonwebtoken": "^8.5.4",
    "@types/nodemailer": "^6.4.4",
    "@types/validator": "13.15.10",
    "@types/wavesurfer.js": "^5.2.0",
    "vite": "^5.4.11",
    "cookie": "0.4.2",
    "jsonwebtoken": "^8.5.1",
    "juice": "8.1.0",
    "jwt-decode": "^3.1.2",
    "md5": "^2.3.0",
    "nodemailer": "6.10.1",
    "prisma": "^7.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^3.8.6",
    "svelte-preprocess": "^5.1.4",
    "svelte-use-form": "3.0.0-beta.0",
    "tslib": "2.8.1",
    "typescript": "^5.6.3",
    "tsx": "^4.20.6",
    "uuid": "^8.3.2",
    "validator": "13.15.26",
    "vite-plugin-windicss": "1.9.4",
    "vitest": "^4.0.18",
    "wavesurfer.js": "^5.2.0"
  },
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "5.1.1",
    "dotenv": "^17.2.3",
    "ffmpeg": "^0.0.4",
    "pg": "^8.16.3",
    "swiper": "^7.0.1"
  }
}
